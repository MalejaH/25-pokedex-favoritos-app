{
  "name": "25-pokedex-favoritos-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "check": "npm run secrets:scan && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "apk": "eas build -p android --profile preview",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-expo": "^58.0.9",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-gesture-handler|react-native-reanimated|react-native-worklets)"
    ],
    "collectCoverageFrom": [
      "src/sensors/tilt.ts",
      "src/services/equipoRules.ts",
      "src/services/pagination.ts",
      "src/components/FavoriteButton.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      }
    }
  }
}
